---
const currentYear = new Date().getFullYear();
---

<footer class="bg-ink text-paper border-t border-paper/10">
  <div class="container-site py-10">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">
      <!-- Copyright -->
      <p class="font-mono text-xs text-paper/70 ">
        &copy; {currentYear} WSN
      </p>
      <a
        href="#"
        class="font-display text-xs text-paper/70 hover:text-accent transition-colors flex items-center gap-2 group"
        aria-label="Back to top"
      >
        Back to top
        <svg class="w-3 h-3 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
