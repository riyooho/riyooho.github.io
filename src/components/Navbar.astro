---
const navLinks = [
  { label: 'Home',     href: '/' },
  { label: 'Portfolio', href: '/projects' },
  { label: 'Blog',      href: '/blog' },
];
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="container-site">
    <nav class="flex items-center justify-between h-16 md:h-18">

      <!-- Logo / Name -->
      <a href="/" class="font-display font-800 text-lg tracking-tight text-ink hover:text-accent transition-colors">
        WSN<span class="text-accent">.</span>
      </a>

      <!-- Desktop Nav -->
      <ul class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-display text-sm font-500 text-muted transition-colors relative group"
            >
              {link.label}
              <span class="absolute -bottom-0.5 left-0 w-0 h-px bg-accent group-hover:w-full transition-all duration-300"></span>
            </a>
          </li>
        ))}
        <li>
          <a href="/contact" class="btn-primary text-xs py-2 px-4">
            Contact Me
          </a>
        </li>
      </ul>

      <!-- Mobile Menu Toggle -->
      <button
        id="menu-toggle"
        class="md:hidden flex flex-col gap-1.5 p-2 text-ink"
        aria-label="Toggle menu"
      >
        <span class="menu-bar w-6 h-px bg-ink transition-all duration-300"></span>
        <span class="menu-bar w-4 h-px bg-ink transition-all duration-300"></span>
        <span class="menu-bar w-6 h-px bg-ink transition-all duration-300"></span>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-surface border-t border-subtle px-6 py-6 space-y-4"
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block font-display text-base font-500 text-ink hover:text-accent transition-colors mobile-nav-link"
      >
        {link.label}
      </a>
    ))}
    <a href="/contact" class="btn-primary inline-block mt-2 text-sm">
      Contact Me
    </a>
  </div>
</header>

<script>
  // Navbar scroll background
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('bg-surface/95', 'backdrop-blur-sm', 'border-b', 'border-subtle', 'shadow-sm');
    } else {
      navbar?.classList.remove('bg-surface/95', 'backdrop-blur-sm', 'border-b', 'border-subtle', 'shadow-sm');
    }
  });

  // Mobile menu toggle
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const bars = document.querySelectorAll('.menu-bar');

  toggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    // Animate bars
    if (!isOpen) {
      bars[0]?.classList.add('rotate-45', 'translate-y-2');
      bars[1]?.classList.add('opacity-0');
      bars[2]?.classList.add('-rotate-45', '-translate-y-2');
    } else {
      bars[0]?.classList.remove('rotate-45', 'translate-y-2');
      bars[1]?.classList.remove('opacity-0');
      bars[2]?.classList.remove('-rotate-45', '-translate-y-2');
    }
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      bars[0]?.classList.remove('rotate-45', 'translate-y-2');
      bars[1]?.classList.remove('opacity-0');
      bars[2]?.classList.remove('-rotate-45', '-translate-y-2');
    });
  });
</script>
