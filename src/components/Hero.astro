---
const socials = [
  {
    name: 'GitHub',
    href: 'https://github.com/riyooho',
    icon: `<svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>`,
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/in/wsnugroho',
    icon: `<svg fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    name: 'Twitter / X',
    href: 'https://twitter.com/riy00ho',
    icon: `<svg fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  }
];

import { getCollection } from 'astro:content';
const allProjects = await getCollection('projects');
const featuredProject = allProjects.find(p => p.data.featured) ?? allProjects[0];
const allPosts = await getCollection('blog');
const latestPost = allPosts.length > 0 
  ? allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0] 
  : null;
 
const postDate = latestPost.data.pubDate.toLocaleDateString('en-EN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<section id="hero" class="relative min-h-screen flex items-center pt-16 overflow-hidden grain">

  <!-- Background geometric accent -->
  <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" aria-hidden="true">
    <div class="absolute top-20 right-0 w-[480px] h-[480px] border border-subtle rounded-full opacity-30 translate-x-1/4"></div>
    <div class="absolute top-32 right-0 w-[320px] h-[320px] border border-subtle rounded-full opacity-20 translate-x-1/4"></div>
  </div>

  <div class="container-site w-full py- md:py-8">
    <div class="grid lg:grid-cols-2 gap-x-24 mb-5 items-start">

      <!-- Bio + Photo Grid -->
      <div class="order-1 lg:order-1" data-animate data-animate-delay="1">

        <!-- Bio Text -->
        <div data-animate data-animate-delay="1">

         <!-- Pre-label -->
         <p class="flex items-center gap-2 section-label mb-5" data-animate>
           <span class="w-2 h-2 bg-green-500 rounded-full inline-block"></span> Open to opportunities
         </p>

          <!-- Headline -->
          <h1 class="font-display font-800 text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[1.0] tracking-tight text-ink mb-8">
            Hello, I'm<br />
            <span class="text-accent">Satrio</span><span class="text-muted">.</span>
            </h1>

          <!-- Subheadline -->
          <p class="font-body text-xl md:text-2xl text-muted max-w-2xl leading-relaxed mb-4">
            <b>Analyst</b> — <em>Warehouse, Logistics, Transport, and Business Operation.</em>
          </p>

          <div class="space-y-4 font-display text-base md:text-lg text-muted leading-relaxed">
              <p>
              Starting my pivot career in a warehouse to a deep fascination with <span class="text-accent">supply chain and the power of data</mark>.
	      </p>
          </div>
    
          <!-- CTA -->
	  <div class="mt-8 flex flex-wrap gap-4 mb-12">
            <a href="/projects" class="btn-primary group">
              View Portfolio
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="/resume_w_satrio_n.pdf" target="_blank" rel="noopener" class="btn-outline">
              Download CV
            </a>
          </div>
        </div>
      </div>

      <!-- Visual accent / avatar area -->
      <div class="order-2 lg:order-2 relative flex items-start justify-center lg:justify-start" data-animate data-animate-delay="2">
        <div class="relative">
        <br/>
          
	  <!-- Avatar placeholder — replace src with your photo -->
          <div class="w-72 h-80 bg-subtle border border-subtle overflow-hidden">
            <div class="w-full h-full flex items-center justify-center">
              <span class="font-display text-7xl font-800 text-muted/30"><img src="/public/images/me.png" alt="Satrio" class="w-full h-full object-cover" loading="lazy" /></span>
            </div>
          </div>
          
	  <!-- Stat chips -->
          <div class="absolute -left-8 top-8 bg-ink text-paper px-4 py-3 text-center shadow-lg">
            <p class="font-display font-800 text-2xl text-accent">5+</p>
            <p class="font-display text-2xs tracking-wider text-paper/70 uppercase">Years Exp.</p>
          </div>

          <!-- Hide # Project
          <div class="absolute -right-8 bottom-8 bg-accent text-paper px-4 py-3 text-center shadow-lg">
            <p class="font-display font-800 text-2xl">20+</p>
            <p class="font-display text-2xs tracking-wider text-paper/80 uppercase">Projects</p>
          </div><br/>
           -->

          <!-- Socials -->
            <div class="flex gap-3">
              {socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-btn"
                  aria-label={social.name}
                >
                  <span class="w-4 h-4" set:html={social.icon} />
                </a>
              ))}
            </div>
        </div>
      </div>

    </div>

  <!-- NOW STRIP ← NEW -->
  <div class="now-strip" data-animate data-animate-delay="3">
    <div class="now-item">
      <div>
        <div class="now-label">Currently</div>
        <div class="now-val">Analyst Lead at <br/><b>Evermos</b>, logistics startup</div>
      </div>
    </div>
    <div class="now-item">
      <div>
        <div class="now-label">Based in</div>
        <div class="now-val">Bandung, West Java · <br/>Willing to relocate to <b>Jabodetabek</b></div>
      </div>
    </div>
    <div class="now-item">
      <div>
        <div class="now-label">Learning</div>
        <div class="now-val">AI Workflow &amp; Analytics</div>
      </div>
    </div>
    <div class="now-item">
      <div>
        <div class="now-label">Open to</div>
        <div class="now-val"><b>Analytics, Excellence, and Process Improvement roles</b> or <b>Freelance</b></div>
      </div>
    </div>
  </div>


    <!-- ── Bottom 3-column strip ── -->
    <div class="mt-4 pt-3 grid grid-cols-1 md:grid-cols-3 gap-8" data-animate data-animate-delay="4">

      <!-- COL 1 · Tools & Technologies -->
      <div>
        <p class="font-display text-2xs font-600 tracking-widest2 uppercase text-muted mb-4">Just Tools</p>
        <div class="flex flex-wrap items-center gap-3">

          <!-- Python -->
          <div class="tech-badge" title="Python">
            <img src="/public/images/python-127-svgrepo-com.svg" class="w-5 h-5"/>
            <span>Python</span>
          </div>

          <!-- SQL -->
          <div class="tech-badge" title="PostgreSQL">
            <img src="/public/images/postgresql-svgrepo-com.svg" class="w-5 h-5"/>
            <span>SQL</span>
          </div>

          <!-- SAP -->
          <div class="tech-badge" title="SAP">
            <img src="/public/images/sap-svgrepo-com.svg" class="w-5 h-5"/>
            <span>SAP</span>
          </div>

          <!-- Excel -->
          <div class="tech-badge" title="Excel">
            <img src="/public/images/excel-file-svgrepo-com.svg" class="w-5 h-5"/>
            <span>Excel</span>
          </div>

          <!-- Google BigQuery / GCP -->
          <div class="tech-badge" title="Google Cloud">
            <img src="/public/images/gcp-svgrepo-com.svg" class="w-5 h-5"/>
            <span>GCP</span>
          </div>

          <!-- Data Viz -->
          <div class="tech-badge" title="Data Viz">
            <img src="/public/images/dashboard-3-svgrepo-com.svg" class="w-5 h-5"/>
            <span>Data Viz</span>
          </div>

          <!-- RPA -->
          <div class="tech-badge" title="RPA">
            <img src="/public/images/brand-zapier-svgrepo-com.svg" class="w-5 h-5"/>
            <span>Zapier</span>
          </div>

          <!-- GIS -->
          <div class="tech-badge" title="GIS">
            <img src="/public/images/arcgis-online-svgrepo-com.svg" class="w-5 h-5"/>
            <span>ArcGIS</span>
          </div>

        </div>
      </div><!-- /COL 1 -->

      <!-- COL 2 · Featured Project — dynamic dari content collection -->
      <div class="border-l border-subtle pl-8">
        <p class="font-display text-2xs font-600 tracking-widest2 uppercase text-muted mb-4">Important Project</p>
        <a href={`/projects/${featuredProject.slug}`} class="group block">
          <!-- Title -->
          <h3 class="font-display font-700 text-base leading-snug text-ink group-hover:text-accent transition-colors mb-2">
            {featuredProject.data.title}
          </h3>
          <!-- Summary -->
          <p class="font-body text-xs text-muted leading-relaxed mb-3">
            {featuredProject.data.description}
          </p>
          <!-- Impact — ambil metric pertama dan kedua -->
          <div class="flex items-center gap-1.5 mb-3">
            <span class="w-1 h-1 bg-accent rounded-full flex-shrink-0"></span>
            <span class="font-mono text-2xs text-accent">
              {featuredProject.data.metrics.slice(0, 2).map(m => `${m.value} ${m.label}`).join(' · ')}
            </span>
          </div>
          <!-- Stack mini tags — max 4 -->
          <div class="flex flex-wrap gap-1.5">
            {featuredProject.data.stack.slice(0, 4).map(t => (
              <span class="font-mono text-2xs px-2 py-0.5 bg-subtle text-muted uppercase tracking-wide">{t}</span>
            ))}
          </div>
          <!-- Read more -->
          <span class="inline-flex items-center gap-1 mt-3 font-display text-2xs font-600 text-muted group-hover:text-accent transition-colors uppercase tracking-wider">
            View case study
            <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
        </a>
      </div><!-- /COL 2 -->


      <!-- COL 3 · Latest Blog — dynamic dari content collection -->
      <div class="border-l border-subtle pl-8">
        <p class="font-display text-2xs font-600 tracking-widest2 uppercase text-muted mb-4">My Latest Blog</p>
        <a href={`/blog/${latestPost.slug}`} class="group block">
          <!-- Title -->
          <h3 class="font-display font-700 text-base leading-snug text-ink group-hover:text-accent transition-colors mb-2">
            {latestPost.data.title}
          </h3>
          <!-- Summary -->
          <p class="font-body text-xs text-muted leading-relaxed mb-3">
            {latestPost.data.description}
          </p>
          <!-- Category + date -->
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="font-mono text-2xs px-2 py-0.5 bg-accent/10 text-accent uppercase tracking-wide border border-accent/20">
              {latestPost.data.category}
            </span>
            <span class="font-mono text-2xs text-muted">{postDate}</span>
          </div>
          <!-- Read more -->
          <span class="flex items-center gap-1 mt-3 font-display text-2xs font-600 text-muted group-hover:text-accent transition-colors uppercase tracking-wider">
            Read article
            <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
        </a>
      </div><!-- /COL 3 -->

    </div>
  </div>
</section>
