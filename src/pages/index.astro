---
import HomeLayout from '../layouts/HomeLayout.astro';
import ProfileBox from '../components/ProfileBox.astro';
import ProjectsBox from '../components/ProjectsBox.astro';
import WritingBox from '../components/WritingBox.astro';
---

<HomeLayout title="Wahyu Satrio Nugroho, business and supply chain analyst" description="Business, operations and supply chain analyst. I find the root cause of a problem, then lead the fix as project manager.">
  <main class="dash">
    <ProfileBox />
    <ProjectsBox />
    <WritingBox />
    <section class="box" id="story" aria-labelledby="sh">
      <div class="hd"><h2 id="sh"><i aria-hidden="true"></i>How I work</h2></div>
    </section>
  </main>
</HomeLayout>
