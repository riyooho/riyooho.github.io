---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Contact Me — Satrio">
  <Navbar />

<section id="contact" class="py-section bg-ink text-paper">
  <div class="container-site">

    <div class="grid lg:grid-cols-2 gap-16 mb-16">

      <!-- Left: Copy -->
      <div data-animate data-animate-delay="1">
        <h2 class="font-display font-800 text-4xl md:text-5xl lg:text-6xl leading-tight mb-6">
          Let's build<br />
          something<br />
          <span class="text-accent">remarkable.</span>
        </h2>
        <p class="font-body text-base text-paper/60 leading-relaxed max-w-sm mb-10">
          Whether you need to untangle a messy supply chain, build a dashboard your team will actually use, or just want to talk data and operations — I'm here.
        </p>

        <!-- Direct email -->
        <a
          href="mailto:riyonugroho@outlook.com"
          class="group inline-flex items-center gap-3 font-display font-600 text-lg text-paper hover:text-accent transition-colors mb-12"
        >
          riyonugroho@outlook.com
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>

	<!-- Add below the email link -->	
 	<p class="text-2xs uppercase tracking-widest text-paper/40 mb-3">I can help with</p>
 	<p class="text-sm text-paper/60">✦ Process mapping &amp; improvement</p>
	<p class="text-sm text-paper/60">✦ SCM analytics &amp; reporting</p>
 	<p class="text-sm text-paper/60">✦ Workflow automation</p>
 	<p class="text-sm text-paper/60">✦ Dashboards &amp; data visualization</p>
      </div>

      <!-- Right: Form -->
      <div data-animate data-animate-delay="2">
        <!-- Replace YOUR_FORM_ID with your Formspree/Getform endpoint -->
        <form
          action="https://formspree.io/f/YOUR_FORM_ID"
          method="POST"
          id="contact-form"
          class="space-y-5"
        >
          <!-- Name -->
          <div>
            <label for="name" class="block font-display text-xs font-600 tracking-wider uppercase text-paper/50 mb-2">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Your full name"
              class="w-full bg-transparent border border-paper/20 text-paper placeholder-paper/30 font-body text-sm px-4 py-3 focus:outline-none focus:border-accent transition-colors"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block font-display text-xs font-600 tracking-wider uppercase text-paper/50 mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
              class="w-full bg-transparent border border-paper/20 text-paper placeholder-paper/30 font-body text-sm px-4 py-3 focus:outline-none focus:border-accent transition-colors"
            />
          </div>

          <!-- Subject -->
          <div>
            <label for="subject" class="block font-display text-xs font-600 tracking-wider uppercase text-paper/50 mb-2">
              Subject
            </label>
            <select
              id="subject"
              name="subject"
              class="w-full bg-ink border border-paper/20 text-paper font-body text-sm px-4 py-3 focus:outline-none focus:border-accent transition-colors appearance-none cursor-pointer"
            >
              <option value="project">Process Improvement Project</option>
	      <option value="dashboard">Analytics & Dashboard Build</option>
              <option value="hire">Job Opportunity</option>
              <option value="freelance">Freelance Work</option>
              <option value="other">Just Saying Hi</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block font-display text-xs font-600 tracking-wider uppercase text-paper/50 mb-2">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Tell me about your project, timeline, and how I can help..."
              class="w-full bg-transparent border border-paper/20 text-paper placeholder-paper/30 font-body text-sm px-4 py-3 focus:outline-none focus:border-accent transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-accent text-paper font-display font-600 text-sm tracking-wide py-4 hover:bg-paper hover:text-ink transition-colors duration-200 flex items-center justify-center gap-2 group"
          >
            <span id="btn-text">Send Message</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
          </button>

          <!-- Success/Error messages -->
          <p id="form-status" class="text-center font-display text-sm hidden"></p>
        </form>
      </div>

    </div>
  </div>
</section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btnText = document.getElementById('btn-text');
  const statusMsg = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (btnText) btnText.textContent = 'Sending…';

    const data = new FormData(form);
    const response = await fetch(form.action, {
      method: 'POST',
      body: data,
      headers: { Accept: 'application/json' },
    });

    if (response.ok) {
      form.reset();
      if (btnText) btnText.textContent = 'Send Message';
      if (statusMsg) {
        statusMsg.textContent = '✓ Message sent! I\'ll get back to you within 24 hours.';
        statusMsg.className = 'text-center font-display text-sm text-accent';
      }
    } else {
      if (btnText) btnText.textContent = 'Send Message';
      if (statusMsg) {
        statusMsg.textContent = '✗ Hmm, something went wrong. Try emailing directly.';
        statusMsg.className = 'text-center font-display text-sm text-red-400';
      }
    }
  });
</script>
